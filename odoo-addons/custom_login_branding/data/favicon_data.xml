<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!--
    Sets the West Bay favicon on the main company record. res.company.favicon
    drives the browser-tab icon across the backend, login and portal pages
    (web.layout renders it as /web/image/res.company/<id>/favicon). Loaded
    without noupdate so it re-applies on every module update, i.e. every
    deploy.
  -->
  <record id="base.main_company" model="res.company">
    <field name="favicon" type="base64" file="custom_login_branding/data/favicon.png"/>
  </record>

</odoo>
